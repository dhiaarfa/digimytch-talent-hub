.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cursor / agent (local only)
.cursorrules
.aider*
skills-lock.json
.agent/

# misc local
.__tests__
/tests
*.local.md
_file_list_temp.txt
.zshrc
.claude/
