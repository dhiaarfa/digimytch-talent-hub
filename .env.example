# =============================================================================
# Digimytch Talent Hub — copier vers .env (local) ou Vercel Environment Variables
# Ne jamais committer .env / .env.local
# =============================================================================

# --- Supabase (local Docker: http://127.0.0.1:54321 | Cloud: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_DIGIMYTCH_TALENT_HUB=1
# NEXT_PUBLIC_BASE_PATH=   # optionnel (sous-chemin)

# --- IA (OpenRouter — chat, CV, entretien, transcription si crédits) ---
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Optionnel : autres fournisseurs BYOK ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe (optionnel si AUTO_PRO_SUBSCRIPTION=true) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# --- Démo locale uniquement (ne pas utiliser en production Vercel) ---
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=Admin123
AUTO_PRO_SUBSCRIPTION=true

# --- Redis rate limiting ---
# Local Docker :
USE_LOCAL_REDIS=true
REDIS_URL=redis://localhost:6379
# Production Vercel (recommandé multi-instance) — désactiver USE_LOCAL_REDIS :
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optionnel) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- CI GitHub Actions (automatique dans le workflow) ---
# CI_MOCK_AI=1
